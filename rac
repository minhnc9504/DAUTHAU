def to_excel(df):
    output = io.BytesIO()
    with pd.ExcelWriter(output, engine='xlsxwriter') as writer:
        df.to_excel(writer, index=False, sheet_name='Sheet1')
    return output.getvalue()

def format_currency(value):
    try:
        if pd.isna(value) or value == "" or value == 0: return "0"
        return "{:,.0f}".format(float(value)).replace(",", ".")
    except: return "0"

def format_date(date_val):
    try:
        if pd.isna(date_val) or date_val == "": return "Chưa cập nhật"
        return pd.to_datetime(date_val).strftime('%d/%m/%Y')
    except: return str(date_val)

def clean_field_name(field):
    if pd.isna(field): return "Khác"
    f = str(field).strip()
    if f in ['HH', 'Hàng hóa']: return 'Hàng hóa'
    if f in ['HON_HOP', 'Hỗn hợp']: return 'Hỗn hợp'
    if f in ['PTV', 'Phi tư vấn']: return 'Phi tư vấn'
    if f in ['TV', 'Tư vấn']: return 'Tư vấn'
    if f in ['XL', 'Xây lắp']: return 'Xây lắp'
    return f

